{
  "name": "beeswax-shares-mcp",
  "version": "1.15.0",
  "description": "MCP server for Beeswax Shares — SMSF portfolio record-keeping over the app's JSON API",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "bin": {
    "beeswax-shares-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "manifest": "npm run build && node scripts/manifest.mjs",
    "manifest:check": "node scripts/manifest.mjs --check",
    "test": "npm run build && node scripts/manifest.mjs --check && node --test test/*.test.mjs",
    "pack:mcpb": "bash scripts/pack-mcpb.sh",
    "release": "bash scripts/release.sh",
    "publish:desktop": "bash scripts/publish.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
